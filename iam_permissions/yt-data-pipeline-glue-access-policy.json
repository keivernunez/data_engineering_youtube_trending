{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "S3FullAccess",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:ListBucket",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::yt-data-pl-bronze/*",
                "arn:aws:s3:::yt-data-pl-bronze",
                "arn:aws:s3:::yt-data-pl-silver/*",
                "arn:aws:s3:::yt-data-pl-silver",
                "arn:aws:s3:::yt-data-pl-gold/*",
                "arn:aws:s3:::yt-data-pl-gold",
                "arn:aws:s3:::yt-data-pl-scripts-dev/*",
                "arn:aws:s3:::yt-data-pl-scripts-dev"
            ]
        }
    ]
}